# Jobber OAuth credentials
# Get these from https://developer.getjobber.com/ by creating a developer app
JOBBER_CLIENT_ID=your_client_id_here
JOBBER_CLIENT_SECRET=your_client_secret_here

# OAuth tokens (managed by the auth flow; for local testing you can paste them here)
JOBBER_ACCESS_TOKEN=
JOBBER_REFRESH_TOKEN=

# Optional: override the API endpoint (defaults to https://api.getjobber.com/api/graphql)
# JOBBER_API_URL=https://api.getjobber.com/api/graphql

# Set to "true" to run against a built-in mock backend (no Jobber account required).
# Useful for demos and CI. The mock returns realistic canned data for all tools.
JOBBER_MOCK_MODE=true
